# ============================================
# TZMICHA AI OS - Configuration
# Copy this to .env and fill in your keys
# ============================================

# ===== Provider Selection (change here to switch) =====
STT_PROVIDER=deepgram       # deepgram | whisper | openai
TTS_PROVIDER=elevenlabs     # elevenlabs | deepgram | piper
LLM_PROVIDER=groq           # groq | ollama | openai | anthropic

# ===== Groq (FREE - get key from https://console.groq.com) =====
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ===== Ollama (Local - no key needed, just install Ollama) =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ===== OpenAI (Paid) =====
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# ===== Anthropic (Paid) =====
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ===== Deepgram (STT + TTS - has free tier) =====
DEEPGRAM_API_KEY=your_deepgram_key_here
DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_TTS_MODEL=aura-asteria-en

# ===== ElevenLabs (Best TTS quality) =====
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2

# ===== Twilio (Real Phone Calls) =====
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
SERVER_PUBLIC_URL=https://your-ngrok-url.ngrok.io

# ===== Platform Settings =====
DEBUG=false
HOST=0.0.0.0
PORT=8000
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,te
MEMORY_WINDOW_SIZE=20
